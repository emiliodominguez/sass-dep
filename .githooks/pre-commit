#!/bin/sh
#
# Pre-commit hook for sass-dep
# Runs checks for both Rust and web app before allowing commits.

set -e

echo "Running pre-commit checks..."

CHECKS_RAN=0

# ============================================
# Rust checks
# ============================================
if command -v cargo >/dev/null 2>&1; then
    RUST_STAGED=$(git diff --cached --name-only --diff-filter=ACMR -- '*.rs' 'Cargo.toml' 'Cargo.lock' 2>/dev/null || true)

    if [ -n "$RUST_STAGED" ]; then
        echo ""
        echo "=== Rust checks ==="
        CHECKS_RAN=1

        echo "Running cargo fmt --check..."
        cargo fmt --check || { echo "Formatting check failed. Run 'cargo fmt'."; exit 1; }

        echo "Running cargo clippy..."
        cargo clippy --all-targets --all-features -- -D warnings || { echo "cargo clippy failed."; exit 1; }

        echo "Running cargo test..."
        cargo test --all-features || { echo "cargo test failed."; exit 1; }

        echo "Rust checks passed!"
    fi
else
    echo "Warning: cargo not found, skipping Rust checks"
fi

# ============================================
# Web app checks
# ============================================
if command -v npm >/dev/null 2>&1 && [ -d "web" ]; then
    WEB_STAGED=$(git diff --cached --name-only --diff-filter=ACMR -- 'web/src/*' 'web/*.ts' 'web/*.js' 'web/package.json' 2>/dev/null || true)

    if [ -n "$WEB_STAGED" ]; then
        echo ""
        echo "=== Web app checks ==="
        CHECKS_RAN=1

        cd web

        echo "Running typecheck..."
        npm run typecheck || { echo "TypeScript type checking failed."; exit 1; }

        echo "Running lint..."
        npm run lint || { echo "ESLint failed."; exit 1; }

        echo "Checking formatting..."
        npx prettier --check src || { echo "Formatting check failed. Run 'npm run format'."; exit 1; }

        cd ..

        echo "Web app checks passed!"
    fi
elif [ -d "web" ]; then
    echo "Warning: npm not found, skipping web checks"
fi

if [ "$CHECKS_RAN" -eq 1 ]; then
    echo ""
    echo "All pre-commit checks passed!"
else
    echo "No relevant files staged, skipping checks."
fi
